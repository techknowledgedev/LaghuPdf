# PdfTwist Environment Configuration
# Copy this file to .env and fill in your values

# ─── API Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# ─── Python Worker ─────────────────────────────────────────────────────────────
PYTHON_WORKER_HOST=http://localhost:8000
PYTHON_WORKER_PORT=8000

# ─── File Handling ─────────────────────────────────────────────────────────────
# Max file size per upload (bytes) — default 100 MB
MAX_FILE_SIZE=104857600
# Max total batch size (bytes) — default 500 MB
MAX_BATCH_SIZE=524288000
# Output file retention in minutes (then auto-deleted)
OUTPUT_FILE_TTL_MINUTES=30
# Temp processing file retention in seconds
TEMP_FILE_TTL_SECONDS=60
# Directory for temporary processing files
TEMP_DIR=/tmp/pdftwist

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per minute per IP (0 = disabled)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ─── Web App ───────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=PdfTwist
VITE_APP_VERSION=0.1.0
